{
  "expo": {
    "name": "Zyra Music",
    "slug": "zyra-music",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.babulu2006.zyramusic",
      "versionCode": 3,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "./rntp.plugin.js"
    ],
    "owner": "babbllu2006",
    "extra": {
      "eas": {
        "projectId": "e457d490-b3ad-4b14-be84-6711dddc49b3"
      }
    }
  }
}
